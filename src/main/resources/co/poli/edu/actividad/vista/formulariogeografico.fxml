<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="505.0" prefWidth="732.0"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.poli.edu.actividad.controlador.ControladorGeografico">
   <children>
      <!-- Botones conectados al controlador -->
      <Button fx:id="btt1" layoutX="149.0" layoutY="56.0" mnemonicParsing="false" text="Crear País"
              onAction="#click"/>
      <Button fx:id="btt2" layoutX="258.0" layoutY="56.0" mnemonicParsing="false" text="Crear Región"
              onAction="#click"/>
      <Button fx:id="btt3" layoutX="366.0" layoutY="56.0" mnemonicParsing="false" text="Crear Ciudad"
              onAction="#click"/>

      <!-- TreeView con fx:id -->
      <TreeView fx:id="info1" layoutX="427.0" layoutY="140.0" prefHeight="312.0" prefWidth="270.0" />

      <!-- Labels y TextFields con fx:id -->
      <Text layoutX="138.0" layoutY="181.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Id" />
      <TextField fx:id="txtId" alignment="TOP_CENTER" layoutX="229.0" layoutY="164.0" />

      <Text layoutX="133.0" layoutY="257.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nombre" />
      <TextField fx:id="txtNombre" layoutX="214.0" layoutY="240.0" />
   </children>
</AnchorPane>
